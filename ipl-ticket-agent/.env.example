# Copy this file to ".env" and fill in your free Hugging Face token.
# Get one at: https://huggingface.co/settings/tokens  (create a free "Read" token)
# Leave it blank and the app still runs in rule-based fallback mode.

HF_TOKEN=

# Optional: pick a free text-generation model on Hugging Face Inference API.
# Good free options:
#   meta-llama/Meta-Llama-3-8B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.2
#   HuggingFaceH4/zephyr-7b-beta
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
